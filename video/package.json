{
  "name": "canon-demo-video",
  "private": true,
  "version": "1.0.0",
  "description": "Canon's demo video, composed with Remotion from headless captures of the site and an ElevenLabs voiceover.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "capture": "node capture/run.mjs",
    "voice": "node scripts/voice.mjs",
    "voice:draft": "node scripts/voice.mjs --draft",
    "still": "node scripts/stills.mjs",
    "render": "remotion render src/index.ts CanonDemo out/canon-demo.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=192k --concurrency=6",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
